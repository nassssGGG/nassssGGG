  </div>
</div>

<!-- ===== 8. NEWSLETTER ===== -->
<div class="adh-nl">
  <div class="adh-wrap">
    <div class="adh-nl-inner">
      <div class="adh-nl-text">Abonnez-vous et recevez nos offres exclusives</div>
      <form class="adh-nl-form" action="/contact#contact_form" method="post">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="adh-nl-input" type="email" name="contact[email]" placeholder="Votre adresse e-mail">
        <button class="adh-nl-submit" type="submit">S'ABONNER</button>
      </form>
    </div>
  </div>
</div>
</div><!-- /.adh -->

<script>
(function(){
/* Tab switching */
window.adhTab=function(tab,btn){
  document.querySelectorAll('.adh-vs-tab').forEach(function(t){t.classList.remove('on');});
  btn.classList.add('on');
  document.getElementById('adh-vs-m').style.display=tab==='m'?'block':'none';
  document.getElementById('adh-vs-i').style.display=tab==='i'?'block':'none';
};

/* VDB dropdowns */
document.addEventListener('DOMContentLoaded',function(){
  var VDB=window.PDZ&&window.PDZ.VDB?window.PDZ.VDB:{};
  var sBr=document.getElementById('adh-brand');
  var sMo=document.getElementById('adh-model');
  var sEn=document.getElementById('adh-engine');
  if(!sBr)return;
  sBr.innerHTML='<option value="">Choisissez une marque</option>';
  Object.keys(VDB).sort().forEach(function(m){
    var o=document.createElement('option');o.value=m;o.textContent=m;sBr.appendChild(o);
  });
  sBr.onchange=function(){
    var mk=this.value;
    sMo.innerHTML='<option value="">Choisissez un modèle</option>';
    sEn.innerHTML='<option value="">Choisissez une motorisation</option>';
    sMo.disabled=!mk;sEn.disabled=true;
    if(mk&&VDB[mk]){
      Object.keys(VDB[mk]).sort().forEach(function(m){
        var o=document.createElement('option');o.value=m;o.textContent=m;sMo.appendChild(o);
      });
    }
  };
  sMo.onchange=function(){
    var mk=sBr.value,md=this.value;
    sEn.innerHTML='<option value="">Choisissez une motorisation</option>';
    sEn.disabled=!md;
    if(mk&&md&&VDB[mk]&&VDB[mk][md]){
      VDB[mk][md].forEach(function(e){
        var o=document.createElement('option');o.value=e;o.textContent=e;sEn.appendChild(o);
      });
    }
  };
  /* Restore saved vehicle */
  var sv=window.PDZ&&window.PDZ.getVehicle?window.PDZ.getVehicle():null;
  if(sv&&sv.make){
    sBr.value=sv.make;sBr.dispatchEvent(new Event('change'));
    setTimeout(function(){
      if(sv.model){sMo.value=sv.model;sMo.dispatchEvent(new Event('change'));
        setTimeout(function(){if(sv.engine)sEn.value=sv.engine;},20);}
    },20);
  }
});

/* Search action */
window.adhSearch=function(){
  var mk=document.getElementById('adh-brand').value;
  var md=document.getElementById('adh-model').value;
  var en=document.getElementById('adh-engine').value;
  if(!mk){alert('Veuillez choisir une marque');return;}
  if(window.PDZ&&window.PDZ.setVehicle){
    window.PDZ.setVehicle({make:mk,model:md,engine:en,label:mk+(md?' '+md:'')+(en?' — '+en:'')});
  }
  window.location.href='/collections/all';
};

/* Immat search */
window.adhImmatSearch=function(){
  var v=document.getElementById('adh-immat-val').value.trim();
  if(!v)return;
  window.location.href='/search?type=product&q='+encodeURIComponent(v);
};

/* A-Z toggle */
window.adhAZToggle=function(){
  var body=document.getElementById('adh-az-body');
  var btn=document.getElementById('adh-az-btn');
  var open=body.classList.toggle('open');
  btn.textContent=open?'▲ Masquer':'▼ Afficher';
};

/* A-Z letter filter */
window.adhAZFilter=function(letter,btn){
  document.querySelectorAll('.adh-az-lbtn').forEach(function(b){b.classList.remove('on');});
  btn.classList.add('on');
  document.querySelectorAll('.adh-az-grp').forEach(function(g){
    g.style.display=(!letter||g.dataset.letter===letter)?'block':'none';
  });
};
})();
</script>

