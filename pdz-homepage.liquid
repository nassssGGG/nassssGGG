<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* BASE */
.pdz *,.pdz *::before,.pdz *::after{box-sizing:border-box;margin:0;padding:0}
.pdz{font-family:'Inter',Arial,sans-serif;color:#132530;background:#fff}
.pdz a{text-decoration:none;color:inherit}
.pdz ul{list-style:none}
.pdz img{display:block}

/* LAYOUT */
.wrap{max-width:1270px;margin:0 auto;padding:0 15px}
.section{padding:28px 0}
.section--grey{background:#f5f6f8}
.section-div{border-top:1px solid #e8ecf0}

/* TYPOGRAPHY */
.section__title{font-family:'Montserrat',Arial,sans-serif;font-size:1.08rem;font-weight:700;text-transform:uppercase;text-align:center;color:#132530;margin-bottom:22px;letter-spacing:.02em;line-height:1.35}
.section__btn{text-align:center;margin-top:20px}

/* BUTTONS */
.btn{display:inline-block;padding:10px 26px;border-radius:3px;font-weight:600;font-size:.84rem;cursor:pointer;border:none;font-family:'Inter',Arial,sans-serif;transition:all .15s;text-decoration:none}
.btn--orange{background:#f85a00;color:#fff}
.btn--orange:hover{background:#d94e00;color:#fff}
.btn--outline-dk{border:1px solid #132530;color:#132530;background:transparent}
.btn--outline-dk:hover{background:#132530;color:#fff}
.btn--outline-wh{border:1px solid rgba(255,255,255,.55);color:#fff;background:rgba(255,255,255,.12)}
.btn--outline-wh:hover{background:rgba(255,255,255,.26);color:#fff}

/* GRID */
.row{display:flex;flex-wrap:wrap;margin:0 -7px}
.row-gap{gap:14px 0}
.col{padding:0 7px}
.row-cols-2>.col{flex:0 0 50%;max-width:50%}
.row-cols-3>.col{flex:0 0 33.333%;max-width:33.333%}

@media(min-width:768px){
  .row-cols-md-3>.col{flex:0 0 33.333%;max-width:33.333%}
  .row-cols-md-4>.col{flex:0 0 25%;max-width:25%}
  .row-cols-md-5>.col{flex:0 0 20%;max-width:20%}
}
@media(min-width:992px){
  .row-cols-lg-4>.col{flex:0 0 25%;max-width:25%}
  .row-cols-lg-6>.col{flex:0 0 16.666%;max-width:16.666%}
  .row-cols-lg-9>.col{flex:0 0 11.111%;max-width:11.111%}
}
@media(min-width:1200px){
  .row-cols-xl-6>.col{flex:0 0 16.666%;max-width:16.666%}
}

/* ANNOUNCE BAR */
.header-promo{background:#f85a00;color:#fff;text-align:center;padding:9px 15px;font-size:.78rem;font-weight:600}
.header-promo a{color:#fff;text-decoration:underline}

/* HERO */
.main-block{background:#132530}
.main-block__inner{display:flex;align-items:stretch;min-height:230px;max-width:1270px;margin:0 auto}

.search-car-box{flex:0 0 41.666%;padding:22px 20px 24px;display:flex;flex-direction:column;justify-content:center}
.search-car-box__title{font-size:.8rem;color:rgba(255,255,255,.7);margin-bottom:14px;line-height:1.45}
.car-selector__tabs{display:flex;border-bottom:1px solid rgba(255,255,255,.15);margin-bottom:16px}
.car-selector__tab{background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-1px;padding:8px 16px;font-size:.8rem;font-weight:500;color:rgba(255,255,255,.5);cursor:pointer;font-family:'Inter',Arial,sans-serif;transition:color .15s}
.car-selector__tab.active,.car-selector__tab:hover{color:#fff}
.car-selector__tab.active{border-bottom-color:#f85a00}
.car-selector__form{display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end}
.car-selector__step{flex:1;min-width:100px}
.car-selector__step-num{font-size:.66rem;font-weight:700;color:#f85a00;margin-bottom:4px}
.car-selector__select{width:100%;padding:9px 10px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:3px;font-size:.8rem;font-family:'Inter',Arial,sans-serif;appearance:none;cursor:pointer}
.car-selector__select option{color:#132530;background:#fff}
.car-selector__select:disabled{opacity:.42;cursor:default}
.car-selector__btn{background:#f85a00;color:#fff;border:none;padding:10px 18px;border-radius:3px;font-weight:700;font-size:.8rem;cursor:pointer;font-family:'Inter',Arial,sans-serif;white-space:nowrap;align-self:flex-end}
.car-selector__btn:hover{background:#d94e00}
.car-selector__note{display:block;margin-top:10px;font-size:.7rem;color:rgba(255,255,255,.4);text-decoration:underline;cursor:pointer}
.car-selector__immat{display:flex;gap:8px;align-items:center}
.car-selector__immat-input{flex:1;padding:9px 10px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:3px;font-size:.8rem;font-family:'Inter',Arial,sans-serif;outline:none}
.car-selector__immat-input::placeholder{color:rgba(255,255,255,.38)}

/* PROMO COL */
.promo-col{flex:1;background:linear-gradient(135deg,#0d2318 0%,#19402c 50%,#0d2318 100%);display:flex;align-items:center;justify-content:center;padding:28px 24px;text-align:center;position:relative;overflow:hidden}
.promo-col::after{content:'';position:absolute;width:220px;height:220px;border-radius:50%;background:rgba(34,197,94,.06);right:-50px;top:50%;transform:translateY(-50%)}
.promo-col__inner{position:relative;z-index:1}
.promo-col__badge{display:inline-block;background:#f85a00;color:#fff;font-size:.62rem;font-weight:700;padding:3px 10px;border-radius:2px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.promo-col__title{font-family:'Montserrat',Arial,sans-serif;font-size:1.3rem;font-weight:800;text-transform:uppercase;color:#fff;line-height:1.3;margin-bottom:10px}
.promo-col__title span{color:#4ade80}
.promo-col__sub{font-size:.76rem;color:rgba(255,255,255,.65);margin-bottom:16px;line-height:1.55}

/* POPULAR LINKS */
.popular-links{background:#fff;border-bottom:1px solid #e8ecf0;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.popular-links::-webkit-scrollbar{display:none}
.popular-links__inner{display:flex;min-width:max-content;max-width:1270px;margin:0 auto}
.popular-links__item{display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:10px 13px;min-width:86px;text-align:center;border-right:1px solid #f0f0f0;transition:background .12s}
.popular-links__item:hover{background:#fff8f5}
.popular-links__icon{width:36px;height:36px;margin-bottom:5px}
.popular-links__label{font-size:.61rem;color:#132530;line-height:1.25;max-width:74px;font-weight:500}

/* TOP-PARTS (categories) */
.top-parts-item{height:100%}
.top-parts-item__content{display:flex;flex-direction:column;align-items:center;background:#fff;border:1px solid #e2e8ed;border-radius:4px;padding:14px 8px 12px;color:#132530;height:100%;transition:border-color .15s,box-shadow .15s}
.top-parts-item__content:hover{border-color:#f85a00;box-shadow:0 2px 10px rgba(248,90,0,.1)}
.top-parts-item__img{width:80px;height:80px;display:flex;align-items:center;justify-content:center;margin-bottom:10px}
.top-parts-item__img img{width:80px;height:80px;object-fit:contain}
.top-parts-item__name{font-size:.72rem;font-weight:600;text-align:center;line-height:1.3;color:#132530}

/* ESSENTIALS */
.essentials-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.essential-card{border-radius:5px;overflow:hidden;text-decoration:none;color:#fff;height:144px;display:flex;align-items:flex-end;padding:16px;position:relative}
.essential-card::before{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(19,37,48,.88) 0%,rgba(19,37,48,.1) 100%)}
.essential-card__inner{position:relative;z-index:1}
.essential-card__title{font-family:'Montserrat',Arial,sans-serif;font-size:.88rem;font-weight:700;text-transform:uppercase;margin-bottom:3px}
.essential-card__sub{font-size:.71rem;opacity:.82}

/* MAKER-BOX (car brands) */
#maker .row{justify-content:center}
.maker-box-item{display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #e2e8ed;border-radius:4px;padding:12px 10px;height:76px;width:100%;transition:border-color .15s,box-shadow .15s}
.maker-box-item:hover{border-color:#c5cdd4;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.maker-box-item img{max-width:100%;max-height:40px;object-fit:contain;filter:grayscale(15%);transition:filter .15s}
.maker-box-item:hover img{filter:none}

/* TRUST BAR */
.autoparts-features-list{background:#f0f2f5;padding:14px 0}
.autoparts-features-list--inline .autoparts-features-list__wrap{display:flex;flex-wrap:wrap;justify-content:space-around;max-width:1270px;margin:0 auto;padding:0 15px}
.autoparts-features-list__item{display:flex;align-items:center;gap:12px;padding:8px 16px;flex:1 1 220px}
.autoparts-features-list__icon{width:40px;height:40px;flex-shrink:0;color:#f85a00}
.autoparts-features-list__icon svg{width:40px;height:40px}
.autoparts-features-list__title{font-size:.8rem;font-weight:700;color:#132530;margin-bottom:2px;font-family:'Montserrat',Arial,sans-serif}
.autoparts-features-list__text{font-size:.68rem;color:#666}

/* PRODUCT CARD GRID */
.product-card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(178px,1fr));gap:12px}
.product-card-grid__item{background:#fff;border:1px solid #e2e8ed;border-radius:4px;text-decoration:none;display:flex;flex-direction:column;overflow:hidden;transition:box-shadow .15s}
.product-card-grid__item:hover{box-shadow:0 3px 14px rgba(0,0,0,.09)}
.product-card-grid__product-img{height:130px;display:flex;align-items:center;justify-content:center;background:#fafafa;border-bottom:1px solid #f0f0f0;padding:8px}
.product-card-grid__product-img img{max-height:114px;max-width:100%;object-fit:contain}
.product-card-grid__body{padding:10px 11px 12px;flex:1;display:flex;flex-direction:column}
.product-card-grid__product-brand{font-size:.63rem;color:#999;text-transform:uppercase;margin-bottom:3px;letter-spacing:.03em}
.product-card-grid__product-name{font-size:.77rem;font-weight:500;color:#132530;margin-bottom:6px;line-height:1.35;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.product-card-grid__product-rating{color:#f85a00;font-size:.72rem;margin-bottom:5px}
.product-card-grid__product-price{font-size:.95rem;font-weight:700;color:#f85a00}
.product-card-grid__product-compare{font-size:.72rem;color:#bbb;text-decoration:line-through;margin-left:5px}
.product-card-grid__add-btn{display:block;background:#f85a00;color:#fff;text-align:center;padding:8px;font-size:.76rem;font-weight:700;margin-top:9px;border-radius:3px}
.product-card-grid__add-btn:hover{background:#d94e00;color:#fff}

/* BRAND-BOX (partner brands) */
#brand .row{justify-content:center}
.brand-box-item{display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #e2e8ed;border-radius:3px;padding:10px 6px;height:60px;width:100%;transition:border-color .15s;text-decoration:none}
.brand-box-item:hover{border-color:#c5cdd4}
.brand-box-item img{max-width:100%;max-height:38px;object-fit:contain}

/* CTA BANNER */
.cta-banner{background:#f85a00;padding:22px 0}
.cta-banner__inner{display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center}
.cta-banner__title{font-family:'Montserrat',Arial,sans-serif;font-size:1rem;font-weight:700;text-transform:uppercase;color:#fff;margin-bottom:4px}
.cta-banner__sub{font-size:.77rem;color:rgba(255,255,255,.9)}
.cta-banner__btns{display:flex;gap:10px;flex-wrap:wrap}

/* NEWSLETTER */
.newsletter{background:#132530;padding:22px 0}
.newsletter__inner{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center}
.newsletter__text{color:#fff;font-weight:700;font-size:.9rem}
.newsletter__form{display:flex}
.newsletter__input{padding:10px 14px;border:none;border-radius:3px 0 0 3px;font-size:.82rem;font-family:'Inter',Arial,sans-serif;width:250px;outline:none}
.newsletter__btn{background:#f85a00;color:#fff;border:none;padding:10px 18px;border-radius:0 3px 3px 0;font-weight:700;font-size:.8rem;cursor:pointer;font-family:'Inter',Arial,sans-serif}
.newsletter__btn:hover{background:#d94e00}

/* RESPONSIVE */
@media(max-width:991px){
  .main-block__inner{flex-direction:column;min-height:unset}
  .search-car-box{flex:none;width:100%}
  .promo-col{flex:none;width:100%;min-height:130px}
}
@media(max-width:767px){
  .section__title{font-size:.9rem}
  .essentials-row{grid-template-columns:1fr}
  .row-cols-md-3>.col{flex:0 0 50%;max-width:50%}
  .row-cols-md-5>.col{flex:0 0 33.333%;max-width:33.333%}
  .product-card-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:575px){
  .car-selector__form{flex-direction:column}
  .car-selector__step{min-width:unset;width:100%}
  .car-selector__btn{align-self:flex-start}
}
@media(max-width:400px){
  .product-card-grid{grid-template-columns:1fr}
}
</style>

