<style>
.adh *{box-sizing:border-box;margin:0;padding:0}
.adh{font-family:'Inter',Arial,sans-serif;color:#132530;background:#fff}
.adh-w{max-width:1270px;margin:0 auto;padding:0 15px}
.adh-title{font-family:'Montserrat','Inter',Arial,sans-serif;font-size:1.05rem;font-weight:700;text-transform:uppercase;color:#132530;text-align:center;margin-bottom:18px;letter-spacing:.02em}
/* ANNOUNCE BAR */
.adh-bar{background:#f85a00;color:#fff;text-align:center;padding:8px 15px;font-size:.78rem;font-weight:600}
.adh-bar a{color:#fff;text-decoration:underline}
/* HERO */
.adh-hero-inner{display:flex;min-height:200px;max-width:1270px;margin:0 auto}
.adh-vs-col{flex:0 0 65%;padding:20px 20px 20px 15px;border-right:1px solid rgba(255,255,255,.1)}
.adh-promo-col{flex:0 0 35%;background:linear-gradient(135deg,#0e1c26 0%,#1a3a2a 50%,#0e1c26 100%);display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;position:relative;overflow:hidden}
.adh-promo-col::before{content:'';position:absolute;right:-20px;top:50%;transform:translateY(-50%);width:140px;height:140px;border-radius:50%;background:rgba(34,197,94,.07)}
.adh-vs-title{color:rgba(255,255,255,.7);font-size:.78rem;margin-bottom:10px}
.adh-vs-tabs{display:flex;border-bottom:1px solid rgba(255,255,255,.15);margin-bottom:14px}
.adh-vs-tab{background:none;border:none;color:rgba(255,255,255,.55);padding:7px 16px 9px;font-size:.8rem;cursor:pointer;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-1px}
.adh-vs-tab.on{color:#fff;border-bottom-color:#f85a00}
.adh-vs-form{display:flex;gap:7px;flex-wrap:nowrap}
.adh-vs-step{flex:1}
.adh-vs-num{color:#f85a00;font-size:.68rem;font-weight:700;margin-bottom:3px}
.adh-vs-sel{width:100%;padding:9px 10px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.07);color:#fff;border-radius:2px;font-size:.8rem;font-family:inherit;appearance:none}
.adh-vs-sel option{color:#132530;background:#fff}
.adh-vs-btn{background:#f85a00;color:#fff;border:none;padding:9px 20px;border-radius:2px;font-weight:700;font-size:.8rem;cursor:pointer;font-family:inherit;white-space:nowrap;align-self:flex-end}
.adh-vs-btn:hover{background:#d94e00}
.adh-vs-nf{color:rgba(255,255,255,.45);font-size:.72rem;display:block;margin-top:8px;text-decoration:underline;cursor:pointer}
.adh-immat-in{flex:1;padding:9px 10px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.07);color:#fff;border-radius:2px;font-size:.8rem;font-family:inherit}
.adh-immat-in::placeholder{color:rgba(255,255,255,.38)}
.adh-promo-badge{background:#f85a00;color:#fff;font-size:.62rem;font-weight:700;padding:3px 8px;border-radius:2px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px;display:inline-block}
.adh-promo-title{color:#fff;font-family:'Montserrat',Arial,sans-serif;font-size:1.1rem;font-weight:700;line-height:1.3;text-transform:uppercase;margin-bottom:8px}
.adh-promo-title span{color:#4ade80}
.adh-promo-sub{color:rgba(255,255,255,.65);font-size:.73rem;margin-bottom:14px;line-height:1.5}
.adh-promo-cta{background:#f85a00;color:#fff;padding:8px 18px;border-radius:2px;text-decoration:none;font-weight:700;font-size:.78rem}
.adh-promo-cta:hover{background:#d94e00}
/* POPULAR LINKS */
.adh-pop{background:#fff;border-bottom:2px solid #f0f0f0;overflow-x:auto;scrollbar-width:none}
.adh-pop::-webkit-scrollbar{display:none}
.adh-pop-inner{display:flex;min-width:max-content;max-width:1270px;margin:0 auto}
.adh-pop-item{display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:10px 13px;min-width:84px;text-align:center}
.adh-pop-item:hover{background:#fff8f5}
.adh-pop-icon{width:38px;height:38px;margin-bottom:5px}
.adh-pop-lbl{font-size:.61rem;color:#132530;line-height:1.2;max-width:74px;font-weight:500}
/* CATEGORIES */
.adh-cats-sec{padding:24px 0 20px;background:#fff}
.adh-cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
@media(max-width:900px){.adh-cat-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:580px){.adh-cat-grid{grid-template-columns:repeat(3,1fr)}}
.adh-cat-card{background:#fff;border:1px solid #e5eaed;border-radius:4px;display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#132530;padding:12px 8px 10px;transition:border-color .15s}
.adh-cat-card:hover{border-color:#f85a00}
.adh-cat-thumb{width:88px;height:66px;border-radius:3px;display:flex;align-items:center;justify-content:center;margin-bottom:9px}
.adh-cat-name{font-size:.72rem;font-weight:600;text-align:center;line-height:1.3}
.bg-tyre{background:linear-gradient(135deg,#2d2d2d,#111)}
.bg-brake{background:linear-gradient(135deg,#4a4a4a,#222)}
.bg-engine{background:linear-gradient(135deg,#1e3a5f,#0a1f3d)}
.bg-belt{background:linear-gradient(135deg,#3d5a2a,#1e2e14)}
.bg-clutch{background:linear-gradient(135deg,#555,#2e2e2e)}
.bg-filter{background:linear-gradient(135deg,#b85000,#6b2e00)}
.bg-shock{background:linear-gradient(135deg,#2a4a6b,#10263d)}
.bg-susp{background:linear-gradient(135deg,#555,#333)}
.bg-body{background:linear-gradient(135deg,#5a1f1f,#2d0f0f)}
.bg-elec{background:linear-gradient(135deg,#2a1a6b,#130e33)}
.bg-oil{background:linear-gradient(135deg,#b86a00,#6b3d00)}
.bg-more{background:#f85a00}
.adh-cats-btn-wrap{text-align:center;margin-top:16px}
.adh-cats-btn{display:inline-block;border:1px solid #132530;color:#132530;padding:8px 24px;border-radius:2px;font-size:.8rem;font-weight:600;text-decoration:none}
.adh-cats-btn:hover{background:#132530;color:#fff}
/* ESSENTIALS */
.adh-ess-sec{background:#f5f5f5;padding:24px 0}
.adh-ess-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
@media(max-width:700px){.adh-ess-grid{grid-template-columns:1fr}}
.adh-ess-card{border-radius:4px;overflow:hidden;text-decoration:none;color:#fff;height:130px;display:flex;align-items:flex-end;padding:14px;position:relative}
.adh-ess-card::before{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(19,37,48,.82) 0%,rgba(19,37,48,.15) 100%)}
.adh-ess-inner{position:relative;z-index:1}
.adh-ess-title{font-family:'Montserrat',Arial,sans-serif;font-size:.85rem;font-weight:700;text-transform:uppercase;margin-bottom:3px}
.adh-ess-sub{font-size:.7rem;opacity:.8}
/* BRANDS */
.adh-brands-sec{background:#fff;padding:22px 0;border-top:1px solid #e8e8e8}
.adh-brands-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:12px}
@media(max-width:580px){.adh-brands-grid{grid-template-columns:repeat(3,1fr)}}
.adh-brand-item{border:1px solid #e5eaed;border-radius:2px;padding:10px 6px;text-align:center;text-decoration:none;color:#132530;font-size:.75rem;font-weight:700;font-family:'Montserrat',Arial,sans-serif;transition:all .15s;letter-spacing:.03em}
.adh-brand-item:hover{border-color:#f85a00;color:#f85a00}
.adh-brands-more{text-align:center}
.adh-brands-more a{font-size:.78rem;color:#f85a00;border:1px solid #f85a00;padding:7px 20px;border-radius:2px;display:inline-block;font-weight:600;text-decoration:none}
/* TRUST */
.adh-trust{background:#f0f2f4;padding:14px 0}
.adh-trust-inner{display:flex;flex-wrap:wrap;justify-content:space-around}
.adh-trust-item{display:flex;align-items:center;gap:10px;padding:8px 16px;flex:1 1 200px}
.adh-trust-icon{width:38px;height:38px;flex-shrink:0;color:#f85a00}
.adh-trust-ttl{font-size:.78rem;font-weight:700;color:#132530;margin-bottom:1px}
.adh-trust-sub{font-size:.66rem;color:#666}
/* BEST SELLERS */
.adh-bs-sec{background:#fff;padding:24px 0}
.adh-prod-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(178px,1fr));gap:10px}
.adh-prod{background:#fff;border:1px solid #e5eaed;border-radius:4px;text-decoration:none;display:flex;flex-direction:column;overflow:hidden;transition:box-shadow .15s}
.adh-prod:hover{box-shadow:0 2px 12px rgba(0,0,0,.1)}
.adh-prod-img{height:126px;display:flex;align-items:center;justify-content:center;background:#fafafa;border-bottom:1px solid #f0f0f0}
.adh-prod-img img{max-height:116px;max-width:100%;object-fit:contain}
.adh-prod-body{padding:9px 10px 11px;flex:1;display:flex;flex-direction:column}
.adh-prod-brand{font-size:.63rem;color:#888;text-transform:uppercase;margin-bottom:2px}
.adh-prod-name{font-size:.76rem;font-weight:500;color:#132530;margin-bottom:5px;line-height:1.3;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.adh-prod-stars{color:#f85a00;font-size:.72rem;margin-bottom:4px}
.adh-prod-price{font-size:.92rem;font-weight:700;color:#f85a00}
.adh-prod-compare{font-size:.7rem;color:#bbb;text-decoration:line-through;margin-left:4px;font-weight:400}
.adh-prod-add{display:block;background:#f85a00;color:#fff;text-align:center;padding:7px;font-size:.74rem;font-weight:700;margin-top:8px;border-radius:2px;text-decoration:none}
.adh-prod-add:hover{background:#d94e00}
/* PARTNERS */
.adh-partners-sec{background:#f5f5f5;padding:16px 0;border-top:1px solid #eaeaea}
.adh-partners-lbl{font-size:.72rem;font-weight:600;color:#666;text-align:center;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}
.adh-partners-row{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.adh-partner{background:#fff;border:1px solid #e5eaed;border-radius:3px;padding:8px 16px;font-size:.78rem;font-weight:700;color:#132530;text-decoration:none;font-family:'Montserrat',Arial,sans-serif;letter-spacing:.03em}
.adh-partner:hover{border-color:#f85a00;color:#f85a00}
/* APP BANNER */
.adh-app{background:#f85a00;padding:18px 0}
.adh-app-inner{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center}
