  function slugify(s){return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'+').replace(/^\+|\+$/g,'');}
  function imgUrl(f){return 'https://scdn.autodoc.de/catalog/categories/100x100/'+f;}

  function openSubcat(panelId,titleId,gridId,key){
    var panel=document.getElementById(panelId);
    var title=document.getElementById(titleId);
    var grid=document.getElementById(gridId);
    var data=SUBCATS[key];if(!data)return;
    title.textContent=data.label;
    grid.innerHTML='';
    data.items.forEach(function(it){
      var a=document.createElement('a');
      a.className='subcat-panel__item';
      a.href='/search?q='+slugify(it.n);
      var html='';
      if(it.img)html+='<img src="'+imgUrl(it.img)+'" alt="" loading="lazy">';
      else html+='<svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="#ccc" stroke-width="1.5"><rect x="4" y="4" width="28" height="28" rx="3"/></svg>';
      html+='<span>'+it.n+'</span>';
      a.innerHTML=html;
      grid.appendChild(a);
    });
    panel.classList.add('is-open');
    var rect=panel.getBoundingClientRect();
    if(rect.top<0||rect.top>window.innerHeight-100)panel.scrollIntoView({behavior:'smooth',block:'nearest'});
  }

  function bindAccordion(gridSel,panelId,titleId,gridId){
    var grid=document.querySelector(gridSel);if(!grid)return;
    var panel=document.getElementById(panelId);
    grid.addEventListener('click',function(e){
      var btn=e.target.closest('[data-cat]');if(!btn)return;
      e.preventDefault();
      var key=btn.getAttribute('data-cat');
      var wasActive=btn.classList.contains('is-active');
      grid.querySelectorAll('.is-active').forEach(function(el){el.classList.remove('is-active');});
      if(wasActive){panel.classList.remove('is-open');return;}
      btn.classList.add('is-active');
      openSubcat(panelId,titleId,gridId,key);
    });
  }

  window.adocCloseSubcat=function(){
    document.getElementById('adoc-subcat-panel').classList.remove('is-open');
    document.querySelectorAll('#adoc-cats-grid .is-active').forEach(function(e){e.classList.remove('is-active')});
