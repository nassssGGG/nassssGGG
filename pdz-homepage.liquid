        <svg class="adh-trust-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="6" width="26" height="22"/><polygon points="28 12 38 12 38 28 28 28"/><circle cx="10" cy="32" r="4"/><circle cx="32" cy="32" r="4"/><path d="M2 22 L8 22"/></svg>
        <div><div class="adh-trust-title">Livraison 48 wilayas</div><div class="adh-trust-sub">Expédition sous 48–72h ouvrées</div></div>
      </div>
      <div class="adh-trust-item">
        <svg class="adh-trust-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="20" cy="20" r="14"/><path d="M20 10 L20 20 L28 24"/></svg>
        <div><div class="adh-trust-title">Garantie 1 an</div><div class="adh-trust-sub">Retours acceptés sous 30 jours</div></div>
      </div>
