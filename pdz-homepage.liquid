<!-- ===== 4. A-Z SECTION ===== -->
<section class="adh-az-sec">
  <div class="adh-wrap">
    <div class="adh-az-hd" onclick="adhAZToggle()">
      <span>Recherche rapide par catégorie A-Z</span>
      <span class="adh-az-toggle" id="adh-az-btn">▼ Afficher</span>
    </div>
    <div class="adh-az-body" id="adh-az-body">
      <div class="adh-az-letters">
        <button class="adh-az-lbtn on" onclick="adhAZFilter('',this)">Tout</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('A',this)">A</button><button class="adh-az-lbtn" onclick="adhAZFilter('B',this)">B</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('C',this)">C</button><button class="adh-az-lbtn" onclick="adhAZFilter('D',this)">D</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('E',this)">E</button><button class="adh-az-lbtn" onclick="adhAZFilter('F',this)">F</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('G',this)">G</button><button class="adh-az-lbtn" onclick="adhAZFilter('H',this)">H</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('I',this)">I</button><button class="adh-az-lbtn" onclick="adhAZFilter('J',this)">J</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('K',this)">K</button><button class="adh-az-lbtn" onclick="adhAZFilter('L',this)">L</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('M',this)">M</button><button class="adh-az-lbtn" onclick="adhAZFilter('N',this)">N</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('O',this)">O</button><button class="adh-az-lbtn" onclick="adhAZFilter('P',this)">P</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('R',this)">R</button><button class="adh-az-lbtn" onclick="adhAZFilter('S',this)">S</button>
        <button class="adh-az-lbtn" onclick="adhAZFilter('T',this)">T</button><button class="adh-az-lbtn" onclick="adhAZFilter('V',this)">V</button>
      </div>
      <div id="adh-az-content">
        {% assign az_items = "Accumulateur de pression|Actuateur de ralenti|Additif carburant|Additifs huile moteur|Aile|Alternateur|Amortisseur|Amortisseur de direction|Arbre de transmission|Axe de roue|Balai d'essuie-glace|Batterie|Bobine d'allumage|Bougie de préchauffage|Bougies d'allumage|Bras de suspension|Cache culbuteurs|Calculateur moteur|Capteur ABS|Capteur de position|Capteur vilebrequin|Cardan|Carter d'huile|Charnière de capot|Clapet EGR|Compresseur climatisation|Compteur kilométrique|Condenseur climatisation|Corps de papillon|Courroie accessoires|Courroie de distribution|Coussin gonflable|Cremaillère de direction|Démarreur|Disque de frein|Durite radiateur|Échangeur thermique|Électrovanne|Embrayage|Essuie-glace|Etrier de frein|Filtre à air|Filtre à carburant|Filtre à huile|Filtre d'habitacle|Fixations|Flexible de frein|Feu arrière|Feu avant|Galets tendeurs|Gicleur|Glace de rétroviseur|Huile moteur|Huile transmission|Injecteur|Intercooler|Jeu de joints|Joint cardan|Joint culasse|Joint d'étanchéité|Kit courroie|Kit de frein|Kit distribution|Kit embrayage|Levier de vitesse|Liquide de frein|Liquide refroidissement|Manomètre|Masse d'équilibrage|Mâchoire de frein|Moyeu de roue|Optique phare|Palier de boîte|Pare-chocs|Pare-poussière|Plaquettes de frein|Pompe à carburant|Pompe à eau|Pompe de direction|Radiateur chauffage|Radiateur d'eau|Rétroviseur|Rotule|Roulement|Sonde de température|Sonde lambda|Soufflet de cardan|Suspension pneumatique|Tendeur de courroie|Thermostat|Tirette de capot|Traverse|Tube d'échappement|Vase d'expansion|Vérin de capot|Vis de roue|Volant moteur" | split: "|" %}
        {% assign current_letter = "" %}
        {% for item in az_items %}
          {% assign first = item | slice: 0 %}
          {% if first != current_letter %}
            {% if current_letter != "" %}</div></div>{% endif %}
            {% assign current_letter = first %}
            <div class="adh-az-grp" data-letter="{{ first }}">
            <div class="adh-az-grp-title">{{ first }}</div>
            <div class="adh-az-list">
          {% endif %}
          <a href="/search?type=product&q={{ item | url_encode }}">{{ item }}</a>
        {% endfor %}
        </div></div>
      </div>
    </div>
  </div>
</section>

<!-- ===== 5. FEATURED PRODUCTS ===== -->
<section class="adh-prods-sec">
  <div class="adh-wrap">
    <div class="adh-prods-hd">NOUVEAUX PRODUITS &amp; BEST-SELLERS</div>
    <div class="adh-prod-grid">
      {% for product in collections.all.products limit: 12 %}
      <a class="adh-prod" href="{{ product.url }}">
        <div class="adh-prod-img">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}" loading="lazy">
          {% else %}
            <svg width="60" height="60" viewBox="0 0 60 60" fill="none"><rect width="60" height="60" rx="4" fill="#f0f0f0"/><path d="M20 40 L20 30 Q22 20 30 18 Q38 20 40 30 L40 40" stroke="#ccc" stroke-width="2" fill="none"/></svg>
          {% endif %}
        </div>
        <div class="adh-prod-body">
          <div class="adh-prod-brand">{{ product.vendor }}</div>
          <div class="adh-prod-title">{{ product.title }}</div>
          <div>
            <span class="adh-prod-price">{{ product.price | money }}</span>
            {% if product.compare_at_price > product.price %}
              <span class="adh-prod-compare">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
          <div class="adh-prod-btn">Ajouter au panier</div>
        </div>
      </a>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:24px"><a href="/collections/all" style="display:inline-block;background:#132530;color:#fff;padding:10px 28px;border-radius:3px;font-weight:700;font-size:.85rem;text-decoration:none">Voir toutes les pièces &rarr;</a></div>
