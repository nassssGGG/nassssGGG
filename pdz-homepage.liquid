.adh-app-btn{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.5);padding:8px 16px;border-radius:4px;font-size:.75rem;font-weight:600;text-decoration:none}
/* NEWSLETTER */
.adh-nl{background:#132530;padding:20px 0}
.adh-nl-inner{display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:center}
.adh-nl-text{color:#fff;font-weight:700;font-size:.88rem}
.adh-nl-form{display:flex}
.adh-nl-input{padding:9px 14px;border:none;border-radius:2px 0 0 2px;font-size:.82rem;font-family:inherit;width:240px}
.adh-nl-submit{background:#f85a00;color:#fff;border:none;padding:9px 16px;border-radius:0 2px 2px 0;font-weight:700;font-size:.78rem;cursor:pointer;font-family:inherit}
.adh-nl-submit:hover{background:#d94e00}
@media(max-width:900px){
  .adh-hero-inner{flex-direction:column}
  .adh-vs-col,.adh-promo-col{flex:none;width:100%}
  .adh-promo-col{min-height:110px}
  .adh-vs-form{flex-wrap:wrap}
}
</style>

