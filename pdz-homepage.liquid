</header>

<!-- ========== 2. HEADER PANEL (vehicle + search + cart) ========== -->
<div class="adoc-header__panel">
  <div class="adoc-header__panel-inner">
    <a href="/collections/all" class="adoc-header__veh-link">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.6"><path d="M3 17V10l2-5h14l2 5v7M3 17h18M3 17v2M21 17v2"/><circle cx="7" cy="17" r="1.5"/><circle cx="17" cy="17" r="1.5"/></svg>
      Voiture de tourisme
    </a>
