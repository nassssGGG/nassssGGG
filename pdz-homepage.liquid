<script>
(function(){
  window.pdzTab=function(tab,btn){
    document.querySelectorAll('.car-selector__tab').forEach(function(t){t.classList.remove('active')});
    btn.classList.add('active');
    document.getElementById('pdz-vs-m').style.display=tab==='m'?'block':'none';
    document.getElementById('pdz-vs-i').style.display=tab==='i'?'block':'none';
  };
  document.addEventListener('DOMContentLoaded',function(){
    var VDB=window.PDZ&&window.PDZ.VDB?window.PDZ.VDB:{};
    var sBr=document.getElementById('pdz-brand');
    var sMo=document.getElementById('pdz-model');
    var sEn=document.getElementById('pdz-engine');
    if(!sBr)return;
    sBr.innerHTML='<option value="">Choisissez une marque</option>';
    Object.keys(VDB).sort().forEach(function(m){var o=document.createElement('option');o.value=m;o.textContent=m;sBr.appendChild(o)});
    sBr.onchange=function(){
      var mk=this.value;
      sMo.innerHTML='<option value="">Choisissez un modèle</option>';
      sEn.innerHTML='<option value="">Motorisation</option>';
      sMo.disabled=!mk;sEn.disabled=true;
      if(mk&&VDB[mk])Object.keys(VDB[mk]).sort().forEach(function(m){var o=document.createElement('option');o.value=m;o.textContent=m;sMo.appendChild(o)});
    };
    sMo.onchange=function(){
      var mk=sBr.value,md=this.value;
      sEn.innerHTML='<option value="">Motorisation</option>';
      sEn.disabled=!md;
      if(mk&&md&&VDB[mk]&&VDB[mk][md])VDB[mk][md].forEach(function(e){var o=document.createElement('option');o.value=e;o.textContent=e;sEn.appendChild(o)});
    };
    var sv=window.PDZ&&window.PDZ.getVehicle?window.PDZ.getVehicle():null;
    if(sv&&sv.make){
      sBr.value=sv.make;sBr.dispatchEvent(new Event('change'));
      setTimeout(function(){if(sv.model){sMo.value=sv.model;sMo.dispatchEvent(new Event('change'));setTimeout(function(){if(sv.engine)sEn.value=sv.engine},20)}},20);
    }
  });
  window.pdzSearch=function(){
    var mk=document.getElementById('pdz-brand').value;
    var md=document.getElementById('pdz-model').value;
    var en=document.getElementById('pdz-engine').value;
    if(!mk){alert('Veuillez choisir une marque');return}
    if(window.PDZ&&window.PDZ.setVehicle)window.PDZ.setVehicle({make:mk,model:md,engine:en,label:mk+(md?' '+md:'')+(en?' — '+en:'')});
    window.location.href='/collections/all';
  };
  window.pdzImmatSearch=function(){
    var v=document.getElementById('pdz-immat-val').value.trim();
    if(!v)return;
    window.location.href='/search?type=product&q='+encodeURIComponent(v);
  };
})();
</script>

