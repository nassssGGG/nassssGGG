  function norm(s){ return (s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,''); }
  function firstLetter(s){ var L = norm(s).charAt(0).toUpperCase(); return /[A-Z]/.test(L) ? L : '#'; }
  function partLink(p){ return (window.PDZ_PART_URL ? window.PDZ_PART_URL(p) : '/search?type=product&q=' + encodeURIComponent(p)); }
  function imgUrl(id){ return CDN + id + '.png'; }
  function imgFallback(name){
    var L = (name || '?').charAt(0).toUpperCase();
    return '<div class="adc__cat-fallback">' + L + '</div>';
  }
  function topFallback(name){
    var L = (name || '?').charAt(0).toUpperCase();
    return '<div class="adc__top-card-fallback">' + L + '</div>';
  }

  function imgWithFallback(id, name, cls){
    // We use onerror to swap to fallback if Autodoc CDN image fails
    return '<img src="' + imgUrl(id) + '" alt="' + name + '" loading="lazy" decoding="async" onerror="this.outerHTML=\'' + (cls === 'top' ? topFallback(name) : imgFallback(name)).replace(/'/g, "\\'") + '\'">';
  }

  // ===== Render TOP grid =====
  function renderTop(target, list){
    var host = document.getElementById(target);
    if (!host) return;
    host.innerHTML = list.map(function(c){
      return '<a class="adc__top-card" href="' + partLink(c.name) + '" data-name="' + norm(c.name) + '">' +
        '<img src="' + imgUrl(c.id) + '" alt="' + c.name + '" loading="lazy" decoding="async" onerror="this.outerHTML=\'<div class=&quot;adc__top-card-fallback&quot;>' + (c.name.charAt(0).toUpperCase()) + '</div>\'">' +
        '<div class="adc__top-card-name">' + c.name + '</div>' +
      '</a>';
    }).join('');
  }

  // ===== Render Main Grid =====
  function renderGrid(){
    var host = document.getElementById('adc-grid');
    if (!host) return;
    host.innerHTML = CATEGORIES.map(function(cat, idx){
      var total = 0;
      cat.groups.forEach(function(g){ total += g.items.length; });
      var groupsHtml = cat.groups.map(function(g){
        var items = g.items.map(function(it){
          return '<li><a href="' + partLink(it) + '" data-name="' + norm(it) + '">' + it + '</a></li>';
        }).join('');
        return '<div class="adc__tooltip-group" data-grp="' + norm(g.title) + '">' +
          '<div class="adc__tooltip-subtitle">' + g.title + '</div>' +
          '<ul class="adc__tooltip-list">' + items + '</ul>' +
        '</div>';
      }).join('');
      return '<div class="adc__cat" data-idx="' + idx + '" data-name="' + norm(cat.name) + '" tabindex="0">' +
        '<div class="adc__cat-head" onclick="adcCatToggle(this.parentNode)">' +
          '<div class="adc__cat-img">' +
            '<img src="' + imgUrl(cat.id) + '" alt="' + cat.name + '" loading="lazy" decoding="async" onerror="this.outerHTML=\'<div class=&quot;adc__cat-fallback&quot;>' + (cat.name.charAt(0).toUpperCase()) + '</div>\'">' +
          '</div>' +
          '<div class="adc__cat-info">' +
            '<div class="adc__cat-name">' + cat.name + '</div>' +
            '<div class="adc__cat-count">' + total + ' sous-catégories</div>' +
          '</div>' +
          '<div class="adc__cat-chev">▾</div>' +
        '</div>' +
        '<div class="adc__tooltip">' +
          '<button class="adc__tooltip-close" type="button" onclick="adcCatClose(event)" aria-label="Fermer">✕</button>' +
          '<div class="adc__tooltip-grid">' + groupsHtml + '</div>' +
          '<div class="adc__tooltip-foot">' +
            '<a class="adc__tooltip-all" href="' + partLink(cat.name) + '">Voir toute la catégorie ' + cat.name + ' →</a>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  window.adcCatToggle = function(card){
    var wasOpen = card.classList.contains('is-open');
    document.querySelectorAll('.adc__cat.is-open').forEach(function(c){ c.classList.remove('is-open'); });
    if (!wasOpen) card.classList.add('is-open');
  };
  window.adcCatClose = function(e){
    if (e) e.stopPropagation();
    document.querySelectorAll('.adc__cat.is-open').forEach(function(c){ c.classList.remove('is-open'); });
  };

  document.addEventListener('click', function(e){
    if (!e.target.closest('.adc__cat')) {
      document.querySelectorAll('.adc__cat.is-open').forEach(function(c){ c.classList.remove('is-open'); });
    }
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') document.querySelectorAll('.adc__cat.is-open').forEach(function(c){ c.classList.remove('is-open'); });
  });

  // ===== Render Alphabetic Index =====
  function buildAlphaIndex(){
    var ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
    var idx = {}; ALPHABET.forEach(function(L){ idx[L] = []; });
    var seen = {};
    CATEGORIES.forEach(function(cat){
      cat.groups.forEach(function(g){
        g.items.forEach(function(p){
          var L = firstLetter(p);
          if (idx[L] && !seen[p + L]) {
            idx[L].push({ name: p, cat: cat.name });
            seen[p + L] = true;
          }
        });
      });
    });
    Object.keys(idx).forEach(function(k){
      idx[k].sort(function(a,b){ return a.name.localeCompare(b.name, 'fr'); });
    });
    return idx;
  }
  function renderAlpha(){
    var ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
    var idx = buildAlphaIndex();
    var nav = document.getElementById('adc-alpha-nav');
    if (!nav) return;
    nav.innerHTML = ALPHABET.map(function(L){
      var has = idx[L].length > 0;
      return '<a href="#adc-L-' + L + '" class="adc__alpha-link ' + (has ? '' : 'is-empty') + '" data-letter="' + L + '">' + L + '</a>';
    }).join('');
    var sec = document.getElementById('adc-alpha-sections');
    sec.innerHTML = ALPHABET.filter(function(L){ return idx[L].length > 0; }).map(function(L){
      var parts = idx[L].map(function(p){
        return '<a href="' + partLink(p.name) + '" class="adc__letter-part" data-name="' + norm(p.name) + '">' + p.name + ' <small>(' + p.cat + ')</small></a>';
      }).join('');
      return '<div class="adc__letter" id="adc-L-' + L + '" data-letter="' + L + '">' +
        '<div class="adc__letter-title">' + L + '</div>' +
        '<div class="adc__letter-grid">' + parts + '</div>' +
      '</div>';
    }).join('');
    document.querySelectorAll('.adc__alpha-link').forEach(function(a){
      a.addEventListener('click', function(e){
        e.preventDefault();
        if (this.classList.contains('is-empty')) return;
        var t = document.getElementById('adc-L-' + this.dataset.letter);
        if (t) t.scrollIntoView({ behavior:'smooth', block:'start' });
      });
    });
  }

  // ===== Search =====
  function applySearch(q){
    q = norm((q || '').trim());
    var anyVisible = false;
    document.querySelectorAll('.adc__cat').forEach(function(cat){
      var name = cat.dataset.name || '';
      var inName = !q || name.indexOf(q) !== -1;
      var grpVisible = 0;
      cat.querySelectorAll('.adc__tooltip-group').forEach(function(g){
        var matches = 0;
        g.querySelectorAll('a').forEach(function(a){
          var match = !q || a.dataset.name.indexOf(q) !== -1;
          if (match) { a.classList.remove('hidden'); matches++; } else a.classList.add('hidden');
        });
        if (q && matches === 0) g.classList.add('hidden');
        else { g.classList.remove('hidden'); if (matches > 0) grpVisible++; }
      });
      if (q && !inName && grpVisible === 0) cat.classList.add('hidden');
      else { cat.classList.remove('hidden'); if (q) cat.classList.add('is-open'); else cat.classList.remove('is-open'); anyVisible = true; }
    });
    // Top grid
    document.querySelectorAll('.adc__top-card').forEach(function(c){
      var match = !q || (c.dataset.name || '').indexOf(q) !== -1;
      if (match) c.classList.remove('hidden'); else c.classList.add('hidden');
    });
    // Alpha
    document.querySelectorAll('.adc__letter-part').forEach(function(el){
      var match = !q || el.dataset.name.indexOf(q) !== -1;
      if (match) el.classList.remove('hidden'); else el.classList.add('hidden');
    });
    document.querySelectorAll('.adc__letter').forEach(function(blk){
      var visible = blk.querySelectorAll('.adc__letter-part:not(.hidden)').length;
      if (q && visible === 0) blk.classList.add('hidden'); else blk.classList.remove('hidden');
    });
    document.getElementById('adc-no-result').style.display = (q && !anyVisible) ? 'block' : 'none';
    document.querySelector('.adc__searchbar').classList.toggle('has-value', !!q);
  }

  function initSearch(){
    var input = document.getElementById('adc-search');
    var clear = document.getElementById('adc-search-clear');
    if (!input) return;
    var t;
    input.addEventListener('input', function(){
      clearTimeout(t);
      var v = this.value;
      t = setTimeout(function(){ applySearch(v); }, 80);
    });
    if (clear) clear.addEventListener('click', function(){
      input.value = ''; applySearch(''); input.focus();
    });
  }

  // ===== Init =====
  function init(){
    renderTop('adc-top-grid', TOP);
    renderTop('adc-acc-grid', ACCESSORIES);
    renderGrid();
    renderAlpha();
    initSearch();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

