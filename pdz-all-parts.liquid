{%- comment -%}
  Catalogue de pièces détachées — version Premium
  - Aligné sur la charte du thème (couleurs, fonts, radius)
  - 100% des liens internes (collections de la boutique)
  - Pas d'index alphabétique : navigation UX moderne avec mega-tooltip
  - Configurable via le schema et entièrement modifiable
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Catalogue de pièces détachées'
  assign subtitle = section.settings.subtitle | default: 'Plus de 500 références · Livraison dans les 48 wilayas · Cash à la livraison'
  assign top_title = section.settings.top_title | default: 'Les pièces les plus demandées'
  assign catalog_title = section.settings.catalog_title | default: 'Toutes les catégories'
-%}

<section class="pdz-cat color-{{ section.settings.color_scheme }} gradient" data-section-id="{{ section.id }}">
  <div class="pdz-cat__hero">
    <div class="pdz-cat__container">
      <nav class="pdz-cat__crumbs" aria-label="Fil d'Ariane">
        <a href="{{ routes.root_url }}">Accueil</a>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        <span aria-current="page">Pièces détachées</span>
      </nav>
      <h1 class="pdz-cat__title">{{ heading }}</h1>
      <p class="pdz-cat__subtitle">{{ subtitle }}</p>

      <ul class="pdz-cat__trust">
        <li><span class="pdz-cat__trust-dot"></span> Garantie 100% pièces neuves</li>
        <li><span class="pdz-cat__trust-dot"></span> Cash à la livraison</li>
        <li><span class="pdz-cat__trust-dot"></span> Support 7j/7</li>
      </ul>
    </div>
  </div>

  <div class="pdz-cat__container">
    <header class="pdz-cat__sec-head">
      <h2 class="pdz-cat__h2">{{ top_title }}</h2>
      <a href="{{ routes.collections_url }}" class="pdz-cat__see-all">Voir toutes les pièces
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </header>
    <div class="pdz-cat__top" id="pdz-cat-top"></div>
  </div>

  <div class="pdz-cat__container">
    <header class="pdz-cat__sec-head">
      <h2 class="pdz-cat__h2">{{ catalog_title }}</h2>
    </header>
    <div class="pdz-cat__grid" id="pdz-cat-grid"></div>
  </div>

  <div class="pdz-cat__container">
    <div class="pdz-cat__cta">
      <div class="pdz-cat__cta-text">
        <h3>Vous ne trouvez pas votre pièce&nbsp;?</h3>
        <p>Notre équipe vous aide à identifier la bonne référence à partir de votre carte grise.</p>
      </div>
      <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="pdz-cat__btn pdz-cat__btn--primary">
        Nous contacter
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
/* Masque le bandeau de compatibilité véhicule (EasySearch YMM) sur cette page car déjà présent dans le header */
.template-page-toutes-les-pieces .easysearch-fitment-header,
.template-page-toutes-les-pieces [class*="easysearch-fitment"],
.template-page-toutes-les-pieces [class*="easysearch-vehicle-info"],
.template-page-toutes-les-pieces .easysearch-embed-widgets,
body.template-page .easysearch-fitment-header{display:none!important}
.pdz-cat{--pdz-bg:#fff;--pdz-surface:#fff;--pdz-surface-2:#f6f9ff;--pdz-primary:#003580;--pdz-primary-2:#00193d;--pdz-primary-soft:#e8f0fc;--pdz-accent:#ffcc00;--pdz-ink:#00193d;--pdz-ink-2:#4a5568;--pdz-muted:#6b7280;--pdz-border:#e3ebf7;--pdz-radius:12px;--pdz-radius-sm:8px;--pdz-radius-pill:999px;--pdz-shadow-sm:0 1px 3px rgba(0,25,61,.05);--pdz-shadow-md:0 4px 14px rgba(0,25,61,.08);--pdz-shadow-lg:0 18px 40px rgba(0,53,128,.18);--pdz-trans:200ms cubic-bezier(.4,0,.2,1);background:var(--pdz-bg);color:var(--pdz-ink);font-family:var(--font-body--family,'Nunito','Inter',system-ui,sans-serif);padding-bottom:64px}
.pdz-cat *,.pdz-cat *::before,.pdz-cat *::after{box-sizing:border-box}
.pdz-cat__container{max-width:1320px;margin:0 auto;padding:0 20px}
.pdz-cat__hero{background:radial-gradient(1200px 400px at 90% -10%,rgba(255,204,0,.14),transparent 60%),linear-gradient(135deg,var(--pdz-primary) 0%,var(--pdz-primary-2) 100%);color:#fff;padding:36px 0 40px;margin-bottom:40px;position:relative;overflow:hidden}
.pdz-cat__hero::after{content:'';position:absolute;inset:auto 0 0 0;height:40px;background:linear-gradient(to bottom,transparent,var(--pdz-bg));pointer-events:none}
.pdz-cat__crumbs{display:flex;align-items:center;gap:6px;font-size:13px;opacity:.85;margin-bottom:18px}
.pdz-cat__crumbs a{color:#fff;text-decoration:none;opacity:.9;transition:opacity var(--pdz-trans)}
.pdz-cat__crumbs a:hover{opacity:1;text-decoration:underline}
.pdz-cat__crumbs span[aria-current]{color:var(--pdz-accent);font-weight:600}
.pdz-cat__title{font-family:var(--font-heading--family,'Roboto',system-ui,sans-serif);font-size:clamp(28px,4vw,42px);font-weight:700;line-height:1.1;letter-spacing:-.02em;margin:0 0 10px;color:#fff}
.pdz-cat__subtitle{font-size:15px;opacity:.92;margin:0 0 28px;max-width:640px}
.pdz-cat__search{position:relative;max-width:680px;background:#fff;border-radius:var(--pdz-radius-pill);box-shadow:var(--pdz-shadow-lg);transition:transform var(--pdz-trans)}
.pdz-cat__search:focus-within{transform:translateY(-1px)}
.pdz-cat__search-ico{position:absolute;left:22px;top:50%;transform:translateY(-50%);color:var(--pdz-primary);pointer-events:none}
.pdz-cat__search input{width:100%;height:56px;border:0;outline:0;padding:0 56px 0 56px;border-radius:inherit;background:transparent;font:inherit;font-size:15.5px;color:var(--pdz-ink)}
.pdz-cat__search input::placeholder{color:var(--pdz-muted)}
.pdz-cat__search-clear{position:absolute;right:16px;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;border:0;background:var(--pdz-primary-soft);color:var(--pdz-primary);font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background var(--pdz-trans)}
.pdz-cat__search-clear:hover{background:var(--pdz-primary);color:#fff}
.pdz-cat__trust{list-style:none;padding:0;margin:22px 0 0;display:flex;flex-wrap:wrap;gap:14px 24px;font-size:13px;opacity:.92}
.pdz-cat__trust li{display:flex;align-items:center;gap:8px}
.pdz-cat__trust-dot{width:6px;height:6px;border-radius:50%;background:var(--pdz-accent);box-shadow:0 0 0 4px rgba(255,204,0,.2)}
.pdz-cat__sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:40px 0 20px}
.pdz-cat__h2{font-family:var(--font-heading--family,'Roboto',system-ui,sans-serif);font-size:clamp(20px,2.4vw,26px);font-weight:700;letter-spacing:-.01em;margin:0;color:var(--pdz-primary-2)}
.pdz-cat__see-all{display:inline-flex;align-items:center;gap:4px;font-size:13px;font-weight:600;color:var(--pdz-primary);text-decoration:none;padding:6px 0;transition:gap var(--pdz-trans),color var(--pdz-trans)}
.pdz-cat__see-all:hover{color:var(--pdz-primary-2);gap:8px}
.pdz-cat__count-hint{font-size:13px;color:var(--pdz-muted)}
.pdz-cat__top{display:grid;grid-template-columns:repeat(8,1fr);gap:10px}
.pdz-cat__top-card{display:flex;flex-direction:column;align-items:center;text-align:center;text-decoration:none;color:var(--pdz-ink);background:var(--pdz-surface);border:1px solid var(--pdz-border);border-radius:var(--pdz-radius);padding:16px 10px 14px;transition:transform var(--pdz-trans),box-shadow var(--pdz-trans),border-color var(--pdz-trans);min-height:142px}
.pdz-cat__top-card:hover{transform:translateY(-3px);border-color:var(--pdz-primary);box-shadow:var(--pdz-shadow-md)}
.pdz-cat__top-img{width:64px;height:64px;display:flex;align-items:center;justify-content:center;margin-bottom:8px}
.pdz-cat__top-img img{width:100%;height:100%;object-fit:contain}
.pdz-cat__top-fb{width:56px;height:56px;background:linear-gradient(135deg,var(--pdz-primary),var(--pdz-primary-2));color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px}
.pdz-cat__top-name{font-size:12.5px;font-weight:600;line-height:1.3;color:var(--pdz-ink)}
.pdz-cat__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.pdz-cat__card{position:relative;background:var(--pdz-surface);border:1px solid var(--pdz-border);border-radius:var(--pdz-radius);transition:border-color var(--pdz-trans),box-shadow var(--pdz-trans),transform var(--pdz-trans)}
.pdz-cat__card:hover{border-color:var(--pdz-primary);box-shadow:var(--pdz-shadow-md);z-index:2}
.pdz-cat__card.is-open{border-color:var(--pdz-primary);box-shadow:var(--pdz-shadow-lg);z-index:30}
.pdz-cat__card-head{display:flex;align-items:center;gap:14px;padding:14px 16px;cursor:pointer;user-select:none;background:none;border:0;width:100%;text-align:left;color:inherit;font:inherit}
.pdz-cat__card-img{flex-shrink:0;width:52px;height:52px;background:var(--pdz-surface-2);border-radius:var(--pdz-radius-sm);display:flex;align-items:center;justify-content:center;overflow:hidden}
.pdz-cat__card-img img{width:44px;height:44px;object-fit:contain}
.pdz-cat__card-fb{width:44px;height:44px;background:linear-gradient(135deg,var(--pdz-primary),var(--pdz-primary-2));color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px}
.pdz-cat__card-info{flex:1;min-width:0}
.pdz-cat__card-name{font-size:14.5px;font-weight:700;line-height:1.25;margin-bottom:3px;color:var(--pdz-ink)}
.pdz-cat__card-meta{font-size:12px;color:var(--pdz-muted)}
.pdz-cat__card-chev{flex-shrink:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;color:var(--pdz-primary);transition:transform var(--pdz-trans)}
.pdz-cat__card.is-open .pdz-cat__card-chev{transform:rotate(180deg)}
.pdz-cat__tooltip{display:none;position:absolute;top:calc(100% + 8px);left:0;right:0;background:var(--pdz-surface);border:1px solid var(--pdz-border);border-radius:var(--pdz-radius);box-shadow:var(--pdz-shadow-lg);padding:22px 22px 18px;min-width:100%}
.pdz-cat__card.is-open .pdz-cat__tooltip{display:block;animation:pdzFade .2s ease}
@keyframes pdzFade{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
.pdz-cat__tooltip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px 24px}
.pdz-cat__tooltip-group{min-width:0}
.pdz-cat__tooltip-subtitle{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--pdz-primary);padding-bottom:8px;margin-bottom:6px;border-bottom:1px solid var(--pdz-border)}
.pdz-cat__tooltip-list{list-style:none;margin:0;padding:0}
.pdz-cat__tooltip-list a{display:flex;align-items:center;gap:8px;padding:6px 8px 6px 6px;font-size:13px;color:var(--pdz-ink-2);text-decoration:none;border-radius:6px;line-height:1.3;transition:background var(--pdz-trans),color var(--pdz-trans),padding var(--pdz-trans)}
.pdz-cat__tooltip-list a::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--pdz-primary);opacity:.5;flex-shrink:0;transition:opacity var(--pdz-trans),transform var(--pdz-trans)}
.pdz-cat__tooltip-list a:hover{background:var(--pdz-primary-soft);color:var(--pdz-primary);padding-left:10px}
.pdz-cat__tooltip-list a:hover::before{opacity:1;transform:scale(1.4)}
.pdz-cat__tooltip-foot{margin-top:16px;padding-top:14px;border-top:1px solid var(--pdz-border);display:flex;justify-content:flex-end}
.pdz-cat__btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;font-family:inherit;font-size:13px;font-weight:700;text-decoration:none;border-radius:var(--pdz-radius-pill);border:1px solid transparent;cursor:pointer;transition:background var(--pdz-trans),color var(--pdz-trans),transform var(--pdz-trans),box-shadow var(--pdz-trans)}
.pdz-cat__btn--primary{background:var(--pdz-primary);color:#fff;border-color:var(--pdz-primary)}
.pdz-cat__btn--primary:hover{background:var(--pdz-primary-2);border-color:var(--pdz-primary-2);transform:translateY(-1px);box-shadow:var(--pdz-shadow-md)}
.pdz-cat__btn--ghost{background:transparent;color:var(--pdz-primary);border-color:var(--pdz-border)}
.pdz-cat__btn--ghost:hover{background:var(--pdz-primary-soft);border-color:var(--pdz-primary)}
.pdz-cat__empty{padding:56px 24px;text-align:center;background:var(--pdz-surface);border:1px dashed var(--pdz-border);border-radius:var(--pdz-radius);color:var(--pdz-muted)}
.pdz-cat__empty svg{color:var(--pdz-border);margin-bottom:14px}
.pdz-cat__empty p{margin:0 0 18px;font-size:14px}
.pdz-cat__cta{margin-top:48px;background:linear-gradient(135deg,var(--pdz-primary-soft),var(--pdz-surface-2));border:1px solid var(--pdz-border);border-radius:var(--pdz-radius);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
.pdz-cat__cta-text h3{font-family:var(--font-heading--family,'Roboto',system-ui,sans-serif);font-size:19px;font-weight:700;margin:0 0 4px;color:var(--pdz-primary-2)}
.pdz-cat__cta-text p{margin:0;font-size:14px;color:var(--pdz-ink-2)}
.pdz-cat__card.is-hidden,.pdz-cat__top-card.is-hidden,.pdz-cat__tooltip-list a.is-hidden,.pdz-cat__tooltip-group.is-hidden{display:none!important}
@media (max-width:1100px){.pdz-cat__top{grid-template-columns:repeat(6,1fr)}.pdz-cat__grid{grid-template-columns:repeat(3,1fr)}.pdz-cat__tooltip-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:760px){.pdz-cat__hero{padding:28px 0 32px;margin-bottom:28px}.pdz-cat__search input{height:50px;font-size:14.5px}.pdz-cat__top{grid-template-columns:repeat(3,1fr);gap:8px}.pdz-cat__top-card{min-height:130px;padding:12px 6px}.pdz-cat__grid{grid-template-columns:1fr 1fr;gap:10px}.pdz-cat__tooltip-grid{grid-template-columns:1fr;gap:14px}.pdz-cat__cta{padding:22px;flex-direction:column;align-items:flex-start;text-align:left}.pdz-cat__sec-head{margin:32px 0 16px}}
@media (max-width:480px){.pdz-cat__grid{grid-template-columns:1fr}.pdz-cat__card-head{padding:12px}}
{% endstylesheet %}

