  function norm(s) { return (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
  function escAttr(s) { return String(s).replace(/"/g, '&quot;'); }
  function imgUrl(id) { return CDN + id + '.png'; }
  function fallbackLetter(name) { var L = (name || '?').charAt(0).toUpperCase(); return /[A-Z]/.test(L) ? L : '?'; }

  function renderTop(host) {
    if (!host) return;
    host.innerHTML = TOP.map(function (c) {
      var href = linkCol(c.h);
      var L = fallbackLetter(c.n);
      return '<a class="pdz-cat__top-card" href="' + href + '" data-name="' + escAttr(norm(c.n)) + '">' +
        '<div class="pdz-cat__top-img"><img src="' + imgUrl(c.id) + '" alt="' + escAttr(c.n) + '" loading="lazy" decoding="async" ' +
        'onerror="this.parentNode.innerHTML=&quot;<div class=\\&quot;pdz-cat__top-fb\\&quot;>' + L + '</div>&quot;"></div>' +
        '<div class="pdz-cat__top-name">' + c.n + '</div></a>';
    }).join('');
  }

  function renderGrid(host) {
    if (!host) return;
    host.innerHTML = CATS.map(function (cat, idx) {
      var total = 0;
      cat.g.forEach(function (g) { total += g.i.length; });
      var L = fallbackLetter(cat.n);
      var groups = cat.g.map(function (g) {
        var items = g.i.map(function (it) {
          return '<li><a href="' + linkCol(cat.h) + '" data-name="' + escAttr(norm(it)) + '">' + it + '</a></li>';
        }).join('');
        return '<div class="pdz-cat__tooltip-group" data-grp="' + escAttr(norm(g.t)) + '">' +
          '<div class="pdz-cat__tooltip-subtitle">' + g.t + '</div>' +
          '<ul class="pdz-cat__tooltip-list">' + items + '</ul></div>';
      }).join('');
      return '<div class="pdz-cat__card" data-idx="' + idx + '" data-name="' + escAttr(norm(cat.n)) + '">' +
        '<button type="button" class="pdz-cat__card-head" aria-expanded="false">' +
        '<span class="pdz-cat__card-img"><img src="' + imgUrl(cat.id) + '" alt="' + escAttr(cat.n) + '" loading="lazy" decoding="async" ' +
        'onerror="this.parentNode.innerHTML=&quot;<div class=\\&quot;pdz-cat__card-fb\\&quot;>' + L + '</div>&quot;"></span>' +
        '<span class="pdz-cat__card-info"><span class="pdz-cat__card-name">' + cat.n + '</span>' +
        '<span class="pdz-cat__card-meta">' + total + ' sous-catégories</span></span>' +
        '<span class="pdz-cat__card-chev" aria-hidden="true">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>' +
        '</span></button>' +
        '<div class="pdz-cat__tooltip" role="region"><div class="pdz-cat__tooltip-grid">' + groups + '</div>' +
        '<div class="pdz-cat__tooltip-foot">' +
        '<a class="pdz-cat__btn pdz-cat__btn--primary" href="' + linkCol(cat.h) + '">Tout voir dans ' + cat.n +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>' +
        '</a></div></div></div>';
    }).join('');

    host.querySelectorAll('.pdz-cat__card-head').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var card = btn.parentNode;
        var willOpen = !card.classList.contains('is-open');
        host.querySelectorAll('.pdz-cat__card.is-open').forEach(function (c) {
          c.classList.remove('is-open');
          var b = c.querySelector('.pdz-cat__card-head');
          if (b) b.setAttribute('aria-expanded', 'false');
        });
        if (willOpen) { card.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
      });
    });
  }

  function init() {
    renderTop(document.getElementById('pdz-cat-top'));
    renderGrid(document.getElementById('pdz-cat-grid'));
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.pdz-cat__card')) {
        document.querySelectorAll('.pdz-cat__card.is-open').forEach(function (c) {
          c.classList.remove('is-open');
          var b = c.querySelector('.pdz-cat__card-head');
          if (b) b.setAttribute('aria-expanded', 'false');
        });
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.pdz-cat__card.is-open').forEach(function (c) { c.classList.remove('is-open'); });
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
{% endjavascript %}

