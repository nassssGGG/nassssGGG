      </div>
    </div>
  </div>
</section>

<style>
.adc{font-family:'Inter','Roboto','Helvetica Neue',Arial,sans-serif;color:#1a1a1a;background:#f7f8fa;padding-bottom:50px}
.adc *,.adc *::before,.adc *::after{box-sizing:border-box}
.adc .container{max-width:1240px;margin:0 auto;padding:0 16px}

.adc__hero{background:linear-gradient(135deg,#003580 0%,#0071bc 100%);color:#fff;padding:28px 0 30px;margin-bottom:24px;position:relative;overflow:hidden}
.adc__hero::before{content:'';position:absolute;top:-40%;right:-10%;width:500px;height:500px;background:radial-gradient(circle,rgba(255,102,0,.15) 0%,transparent 60%);pointer-events:none}
.adc__crumbs{font-size:12px;margin-bottom:12px;opacity:.9}
.adc__crumbs a{color:#fff;text-decoration:none;opacity:.85}
.adc__crumbs a:hover{opacity:1;text-decoration:underline}
.adc__crumbs span{margin:0 6px;opacity:.6}
.adc__crumbs-current{opacity:.7}
.adc__title{font-size:28px;font-weight:700;margin:0 0 6px;letter-spacing:-.3px}
.adc__subtitle{font-size:14px;opacity:.92;margin:0 0 22px;line-height:1.5}
.adc__searchbar{position:relative;max-width:640px;background:#fff;border-radius:6px;box-shadow:0 4px 16px rgba(0,0,0,.12)}
.adc__searchbar svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:#6b7280;pointer-events:none}
.adc__searchbar input{width:100%;height:50px;border:none;border-radius:6px;padding:0 50px 0 46px;font-size:14.5px;font-family:inherit;outline:none;background:transparent;color:#1a1a1a}
.adc__searchbar input:focus{box-shadow:0 0 0 3px rgba(255,102,0,.35)}
.adc__searchbar-clear{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:#f3f4f6;border:none;width:28px;height:28px;border-radius:50%;cursor:pointer;color:#6b7280;font-size:13px;display:none;align-items:center;justify-content:center;transition:all .15s ease}
.adc__searchbar-clear:hover{background:#e5e7eb;color:#1a1a1a}
.adc__searchbar.has-value .adc__searchbar-clear{display:flex}

.adc__h2{font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#1a1a1a;margin:32px 0 16px;padding-left:14px;border-left:4px solid #ff6600;line-height:1.3}
.adc__h2--no-pad{margin-top:0}
.adc__sub2{font-size:13px;color:#6b7280;margin:0 0 16px;padding-left:18px}
.adc__catalog-head{margin-top:30px}

/* TOP categories grid (8 columns desktop) */
.adc__top-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:10px;background:#fff;border:1px solid #e8e8e8;border-radius:6px;padding:14px}
.adc__top-card{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;text-align:center;text-decoration:none;color:#1a1a1a;padding:10px 6px;border-radius:5px;transition:all .18s ease;border:1px solid transparent;background:#fff;min-height:120px}
.adc__top-card:hover{background:#f0f7ff;border-color:#0071bc;transform:translateY(-2px);box-shadow:0 4px 14px rgba(0,113,188,.15)}
.adc__top-card img{width:62px;height:62px;object-fit:contain;margin-bottom:6px;transition:transform .18s ease}
.adc__top-card:hover img{transform:scale(1.08)}
.adc__top-card-name{font-size:11.5px;line-height:1.3;font-weight:500;color:#374151}
.adc__top-card:hover .adc__top-card-name{color:#0071bc}
.adc__top-card-fallback{width:62px;height:62px;background:#f3f4f6;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:6px;color:#9ca3af;font-size:22px;font-weight:700}

/* Main catalog grid — parent categories with hover tooltips */
.adc__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}
.adc__cat{position:relative;background:#fff;border:1px solid #e8e8e8;border-radius:5px;cursor:pointer;transition:all .18s ease;user-select:none}
.adc__cat:hover{border-color:#0071bc;box-shadow:0 3px 12px rgba(0,113,188,.12);z-index:2}
.adc__cat.is-open{border-color:#ff6600;box-shadow:0 4px 16px rgba(255,102,0,.2);z-index:10}
.adc__cat-head{display:flex;align-items:center;gap:12px;padding:12px 14px}
.adc__cat-img{flex-shrink:0;width:54px;height:54px;background:#f8fafc;border-radius:5px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.adc__cat-img img{width:48px;height:48px;object-fit:contain}
.adc__cat-fallback{width:48px;height:48px;background:linear-gradient(135deg,#0071bc,#003580);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:700}
.adc__cat-info{flex:1;min-width:0}
.adc__cat-name{font-size:13.5px;font-weight:600;color:#1a1a1a;line-height:1.3;margin-bottom:2px}
.adc__cat-count{font-size:11px;color:#6b7280}
.adc__cat-chev{color:#0071bc;font-size:11px;transition:transform .25s cubic-bezier(0.4,0,0.2,1);flex-shrink:0}
.adc__cat.is-open .adc__cat-chev{transform:rotate(180deg);color:#ff6600}

/* Tooltip / expanded panel */
.adc__tooltip{display:none;position:absolute;top:calc(100% + 6px);left:0;right:0;background:#fff;border:1px solid #ff6600;border-radius:6px;box-shadow:0 12px 32px rgba(0,0,0,.18);z-index:50;padding:18px 20px 16px;animation:adcFade .22s ease}
.adc__cat.is-open .adc__tooltip{display:block}
@keyframes adcFade{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
.adc__tooltip-close{position:absolute;top:8px;right:10px;background:none;border:none;color:#9ca3af;font-size:16px;cursor:pointer;line-height:1;padding:6px;transition:all .15s ease}
.adc__tooltip-close:hover{color:#ff6600;transform:rotate(90deg)}
.adc__tooltip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px 20px;margin-right:24px}
.adc__tooltip-group{min-width:0}
.adc__tooltip-subtitle{font-size:12px;font-weight:700;color:#0071bc;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;padding-bottom:5px;border-bottom:1.5px solid #f3f4f6}
.adc__tooltip-list{list-style:none;margin:0;padding:0}
.adc__tooltip-list li{margin:0}
.adc__tooltip-list a{display:flex;align-items:center;gap:7px;padding:5px 4px;font-size:12.5px;color:#374151;text-decoration:none;border-radius:3px;transition:all .12s ease;line-height:1.35}
.adc__tooltip-list a::before{content:'';width:4px;height:4px;background:#0071bc;border-radius:50%;flex-shrink:0;opacity:.6;transition:all .12s ease}
.adc__tooltip-list a:hover{color:#0071bc;background:#f0f7ff;padding-left:8px}
.adc__tooltip-list a:hover::before{opacity:1;transform:scale(1.5);background:#ff6600}
.adc__tooltip-foot{margin-top:14px;padding-top:12px;border-top:1px solid #f3f4f6;text-align:right}
.adc__tooltip-all{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:#fff;background:#0071bc;font-weight:700;text-decoration:none;padding:8px 14px;border-radius:3px;text-transform:uppercase;letter-spacing:.5px;transition:all .15s ease}
.adc__tooltip-all:hover{background:#003580;transform:translateY(-1px);box-shadow:0 3px 10px rgba(0,113,188,.3)}

/* Alpha section */
.adc__alpha-nav{display:grid;grid-template-columns:repeat(13,1fr);gap:4px;background:#fff;border:1px solid #e8e8e8;border-radius:5px;padding:10px;margin-bottom:18px;position:sticky;top:0;z-index:20}
.adc__alpha-link{display:flex;align-items:center;justify-content:center;height:32px;border-radius:3px;font-size:12.5px;font-weight:700;color:#0071bc;text-decoration:none;background:#f0f7ff;border:1px solid #e0e7ff;transition:all .15s ease}
.adc__alpha-link:hover:not(.is-empty){background:#0071bc;color:#fff;transform:translateY(-1px);box-shadow:0 2px 6px rgba(0,113,188,.3)}
.adc__alpha-link.is-active{background:#ff6600;color:#fff;border-color:#ff6600}
.adc__alpha-link.is-empty{opacity:.35;pointer-events:none}
.adc__alpha-sections{display:flex;flex-direction:column;gap:14px;margin-bottom:32px}
.adc__letter{background:#fff;border:1px solid #e8e8e8;border-radius:5px;padding:14px 18px;scroll-margin-top:60px}
.adc__letter-title{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;background:linear-gradient(135deg,#0071bc,#003580);color:#fff;font-size:18px;font-weight:700;border-radius:50%;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,113,188,.3)}
.adc__letter-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:2px 14px}
.adc__letter-part{display:flex;align-items:baseline;gap:6px;padding:5px 4px;font-size:12.5px;color:#374151;text-decoration:none;border-bottom:1px dashed transparent;transition:all .15s ease;border-radius:3px}
.adc__letter-part:hover{color:#0071bc;border-bottom-color:#0071bc;padding-left:6px}
.adc__letter-part small{color:#9ca3af;font-size:10.5px;font-weight:500}

.adc__no-result{padding:50px 20px;text-align:center;color:#6b7280;font-size:13.5px;background:#fff;border:1px solid #e8e8e8;border-radius:5px;margin-bottom:24px}
.adc__no-result p{margin:10px 0 0}

/* Trust bar */
.adc__trust{margin-top:30px;background:#fff;border:1px solid #e8e8e8;border-radius:6px;padding:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.adc__trust-item{display:flex;align-items:center;gap:12px;color:#0071bc}
.adc__trust-title{font-size:13.5px;font-weight:600;color:#1a1a1a;margin-bottom:2px}
.adc__trust-desc{font-size:11.5px;color:#6b7280}

.adc__cat.hidden,.adc__top-card.hidden,.adc__letter.hidden,.adc__letter-part.hidden,.adc__tooltip-list a.hidden,.adc__tooltip-group.hidden{display:none!important}

@media (max-width:1100px){
  .adc__top-grid{grid-template-columns:repeat(6,1fr)}
  .adc__grid{grid-template-columns:repeat(3,1fr)}
  .adc__alpha-nav{grid-template-columns:repeat(13,1fr)}
  .adc__trust{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:760px){
  .adc__title{font-size:22px}
  .adc__top-grid{grid-template-columns:repeat(3,1fr);padding:10px;gap:6px}
  .adc__top-card{min-height:108px;padding:8px 4px}
  .adc__top-card img{width:52px;height:52px}
  .adc__top-card-name{font-size:11px}
  .adc__grid{grid-template-columns:1fr 1fr;gap:8px}
  .adc__cat-head{padding:10px 12px;gap:10px}
  .adc__cat-img{width:46px;height:46px}
  .adc__cat-img img{width:40px;height:40px}
  .adc__cat-name{font-size:12.5px}
  .adc__tooltip-grid{grid-template-columns:1fr;margin-right:0;gap:10px}
  .adc__alpha-nav{grid-template-columns:repeat(7,1fr);position:relative}
  .adc__letter-grid{grid-template-columns:1fr}
  .adc__trust{grid-template-columns:1fr;gap:14px}
}
</style>

