<section class="adc">
  <div class="adc__hero">
    <div class="container">
      <nav class="adc__crumbs" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span>›</span>
        <span class="adc__crumbs-current">Pièces détachées</span>
      </nav>
      <h1 class="adc__title">Catalogue de pièces détachées</h1>
      <p class="adc__subtitle">Plus de 500 références&nbsp;· Livraison dans les 48 wilayas&nbsp;· Cash à la livraison</p>
      <div class="adc__searchbar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="adc-search" type="text" placeholder="Saisissez la catégorie (p. ex. frein, filtre, amortisseur)" autocomplete="off">
        <button type="button" class="adc__searchbar-clear" id="adc-search-clear" aria-label="Effacer">✕</button>
      </div>
    </div>
  </div>

  <div class="container">
    <h2 class="adc__h2">LE TOP DES PIÈCES LES PLUS DEMANDÉES</h2>
    <div class="adc__top-grid" id="adc-top-grid"></div>
  </div>

  <div class="container">
    <div class="adc__catalog-head">
      <h2 class="adc__h2 adc__h2--no-pad">CATALOGUE DE PIÈCES DÉTACHÉES</h2>
      <p class="adc__sub2">Recherche rapide par catégorie</p>
    </div>
    <div class="adc__grid" id="adc-grid"></div>
  </div>

  <div class="container">
    <h2 class="adc__h2">INDEX ALPHABÉTIQUE</h2>
    <div class="adc__alpha-nav" id="adc-alpha-nav"></div>
    <div class="adc__alpha-sections" id="adc-alpha-sections"></div>
    <div class="adc__no-result" id="adc-no-result" style="display:none">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <p>Aucune pièce trouvée pour votre recherche.</p>
    </div>
  </div>

  <div class="container">
    <h2 class="adc__h2">ACCESSOIRES & ÉQUIPEMENTS</h2>
    <div class="adc__top-grid" id="adc-acc-grid"></div>
  </div>

  <div class="container">
    <div class="adc__trust">
      <div class="adc__trust-item">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <div><div class="adc__trust-title">Commande sécurisée</div><div class="adc__trust-desc">Pièces 100% authentiques</div></div>
      </div>
      <div class="adc__trust-item">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <div><div class="adc__trust-title">Cash à la livraison</div><div class="adc__trust-desc">Payez à la réception</div></div>
      </div>
      <div class="adc__trust-item">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
